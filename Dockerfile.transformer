FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
COPY pyproject.toml ./
COPY src ./src
COPY app ./app
RUN pip install --no-cache-dir ".[transformers]" && useradd --uid 10001 --create-home appuser
USER 10001
EXPOSE 8000
CMD ["uvicorn", "app.transformer_api:app", "--host", "0.0.0.0", "--port", "8000"]
